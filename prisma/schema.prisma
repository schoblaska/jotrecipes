generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "sqlite"
}

model Recipe {
  id    String @id @default(cuid())
  slug  String @unique
  hash  String @unique
  title String
  text  String

  @@index([slug])
  @@index([hash])
}
